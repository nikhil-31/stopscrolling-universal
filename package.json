{
  "name": "stopscrolling",
  "version": "0.1.0",
  "description": "Stop Scrolling desktop tracker (Electron) — Mac feature parity without blocking",
  "main": "./out/main/index.js",
  "author": "Stop Scrolling",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "electron-vite build",
    "preview": "node scripts/dev.mjs preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:ui": "playwright test",
    "test:ui:update": "playwright test --update-snapshots",
    "native:prepare-release": "node scripts/prepare-native-release.mjs",
    "native:test:macos": "cd native/macos && swift test",
    "native:test:windows-portable": "cmake -S native/windows -B out/windows-portable && cmake --build out/windows-portable --parallel && ctest --test-dir out/windows-portable --output-on-failure",
    "prepack": "npm run native:prepare-release",
    "pack": "npm run build && electron-builder --dir",
    "predist": "npm run native:prepare-release",
    "dist": "npm run build && electron-builder",
    "dist:mac-signed": "npm run native:prepare-release && npm run build && electron-builder --config electron-builder.mac-signed.yml"
  },
  "dependencies": {
    "koffi": "^3.2.1",
    "lucide-react": "^1.43.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.4",
    "vitest": "^3.1.2"
  }
}
