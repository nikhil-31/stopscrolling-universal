<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>com.stopscrolling.desktop</string>
    </array>
    <key>Label</key>
    <string>com.stopscrolling.helper</string>
    <key>BundleProgram</key>
    <string>Contents/Library/PrivilegedHelperTools/com.stopscrolling.helper</string>
    <key>MachServices</key>
    <dict>
        <key>com.stopscrolling.helper</key>
        <true/>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <!-- A crash is relaunched only while verified strict state owns this marker. -->
        <key>PathState</key>
        <dict>
            <key>/Library/Application Support/StopScrolling/strict-active</key>
            <true/>
        </dict>
    </dict>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>/var/log/com.stopscrolling.helper.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/com.stopscrolling.helper.log</string>
</dict>
</plist>
